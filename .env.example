# =====================================================
# Railflow — Production Environment Configuration
# Copy to .env and fill in your secrets before deploy.
# =====================================================

# ---- Server ----
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
# In docker-compose, this points to the postgres service.
DATABASE_URL=postgres://railflow:railflow_secret_change_me@postgres:5432/railflow
DATABASE_MAX_CONNECTIONS=20

# ---- JWT Authentication ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_256_bit_random_hex_string
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ---- Docker ----
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_REGISTRY=ghcr.io

# ---- GitHub OAuth ----
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random secret for webhook signature verification
GITHUB_WEBHOOK_SECRET=

# ---- 2FA / TOTP ----
TOTP_ISSUER=Railflow
TOTP_DIGITS=6
TOTP_STEP=30

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=https://railflow.io,https://app.railflow.io

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=100

# ---- Deployment ----
BUILD_TIMEOUT_SECONDS=900
MAX_CONCURRENT_BUILDS=4

# ---- Redis (for cache + rate limiting) ----
REDIS_URL=redis://redis:6379/0

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ---- S3 Backups (optional) ----
S3_BUCKET=railflow-backups
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Email (optional, for notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@railflow.io

# ---- Slack (optional) ----
SLACK_WEBHOOK_URL=
