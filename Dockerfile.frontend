# ============================================================
# Railflow Frontend — Next.js 16 production image
# Multi-stage build with standalone output for minimal size.
# ============================================================

# ---------- Stage 1: Dependencies ----------
FROM node:22-alpine AS deps
WORKDIR /app

# Install bun for faster, reliable installs
RUN npm install -g bun

# Copy only manifests to cache deps layer
COPY package.json bun.lock* package-lock.json* ./
COPY next.config.ts tsconfig.json ./
COPY tailwind.config.ts postcss.config.mjs ./
COPY components.json ./

# Install (prefer frozen lockfile)
RUN bun install --frozen-lockfile || bun install

# ---------- Stage 2: Build ----------
FROM node:22-alpine AS builder
WORKDIR /app

RUN npm install -g bun

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Disable telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

# Build with standalone output
RUN bun run build

# ---------- Stage 3: Runtime ----------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output (server.js + minimal node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
